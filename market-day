            </div>

            <div class="stock-bottom">

                <div class="change ${movementClass}">
                    ${movement >= 0 ? "+" : ""}
                    ${(movement * 100).toFixed(1)}%
                    today
                </div>

                <div class="stock-actions">

                    <button
                        class="small-btn"
                        onclick="openTrade('buy', '${company.ticker}')">
