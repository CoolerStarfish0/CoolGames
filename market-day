--------------------------------------------------------- */

function renderStats() {

    const worth = getNetWorth();

    document.getElementById("netWorth").textContent =
        money(worth);

    document.getElementById("cash").textContent =
        money(cash);

    document.getElementById("invested").textContent =
        money(getStockValue() + getTotalBankMoney());

    const pl =
        worth - dailyStartWorth;

    const plElement =
        document.getElementById("dailyPL");

    plElement.textContent =
        (pl >= 0 ? "+" : "") + money(pl);

    plElement.className =
        "stat-value " +
        (pl >= 0 ? "green" : "red");
}


