/* ---------------------------------------------------------
   BUY / SELL
--------------------------------------------------------- */

function openTrade(mode, ticker) {

    tradeMode = mode;

    tradeStock =
        companies.find(
            company => company.ticker === ticker
        );

    if (!tradeStock) return;

    document.getElementById("modalTitle").textContent =
        mode === "buy"
            ? `Buy ${tradeStock.name}`
            : `Sell ${tradeStock.name}`;

    document.getElementById("modalDescription").textContent =
        `${tradeStock.ticker} is currently ${money(tradeStock.price)} per share.`;

    document.getElementById("tradeAmount").value = "";

    document.getElementById("tradeModal")
        .classList.add("open");

    setTimeout(() => {
        document.getElementById("tradeAmount").focus();
    }, 50);
}


function closeModal() {

    document.getElementById("tradeModal")
        .classList.remove("open");

    tradeMode = null;
    tradeStock = null;
}


function confirmTrade() {

    if (!tradeStock) return;

    const amount =
        Number(
            document.getElementById("tradeAmount").value
        );

    if (!Number.isFinite(amount) || amount <= 0) {

        alert("Enter a valid amount.");

        return;
    }

    const total =
        amount * tradeStock.price;

    if (tradeMode === "buy") {

        if (total > cash) {

            alert(
                `You only have ${money(cash)} available.`
            );

            return;
        }

        cash -= total;

        tradeStock.shares += amount;

        totalTrades++;

        document.getElementById("marketEvent").textContent =
            `You bought ${amount.toFixed(2)} shares of ${tradeStock.name} for ${money(total)}.`;

    } else {

        if (amount > tradeStock.shares) {

            alert(
                `You only own ${tradeStock.shares.toFixed(2)} shares.`
            );

            return;
        }

        cash += total;

        tradeStock.shares -= amount;

        totalTrades++;

        document.getElementById("marketEvent").textContent =
            `You sold ${amount.toFixed(2)} shares of ${tradeStock.name} for ${money(total)}.`;
    }

    closeModal();

    renderEverything();
}


/* ---------------------------------------------------------
   BANK DEPOSITS
--------------------------------------------------------- */

function openDeposit(type) {

    depositMode = type;

    const names = {
        current: "Current Account",
        savings: "Savings Account",
        rd: "Recurring Deposit",
        fd: "Fixed Deposit"
    };

    document.getElementById("depositTitle").textContent =
        `Deposit → ${names[type]}`;

    document.getElementById("depositDescription").textContent =
        `You have ${money(cash)} in available cash.`;

    document.getElementById("depositAmount").value = "";

    document.getElementById("depositModal")
        .classList.add("open");

    setTimeout(() => {
        document.getElementById("depositAmount").focus();
    }, 50);
}


function closeDeposit() {

    document.getElementById("depositModal")
        .classList.remove("open");

    depositMode = null;
}


function confirmDeposit() {

    const amount =
        Number(
            document.getElementById("depositAmount").value
        );

    if (!Number.isFinite(amount) || amount <= 0) {

        alert("Enter a valid amount.");

        return;
    }

    if (amount > cash) {

        alert(
            `You only have ${money(cash)} cash available.`
        );

        return;
    }

    cash -= amount;

    if (depositMode === "current") {

        currentAccount += amount;

    } else if (depositMode === "savings") {

        savingsAccount += amount;

    } else if (depositMode === "rd") {

        recurringDeposit += amount;

    } else if (depositMode === "fd") {

        fixedDeposit += amount;
    }

    document.getElementById("marketEvent").textContent =
        `You deposited ${money(amount)} into your ${depositMode} account.`;

    closeDeposit();

    renderEverything();
}


/* ---------------------------------------------------------
   DAILY MARKET MOVEMENT
--------------------------------------------------------- */

function moveMarkets() {

    companies.forEach(company => {

        let movement =
            random(
                -company.volatility,
                company.volatility
            );

        const newsEffect =
            todayEvent.effects[company.ticker] || 0;

        movement += newsEffect;

        /*
         * Occasionally the market does something stupid.
         */

        if (Math.random() < 0.04) {

            movement += random(-0.20, 0.20);
        }

        company.price *=
            1 + movement;

        /*
         * Prices can't become zero.
         */

        if (company.price < 1) {

            company.price = 1;
        }

        /*
         * And occasionally something goes absolutely
         * ridiculous.
         */

        if (company.price > 200) {

            company.price *= 0.97;
        }
    });
}


/* ---------------------------------------------------------
   BANK INTEREST
--------------------------------------------------------- */

function applyInterest() {

    /*
     * These are deliberately simplified game mechanics,
     * not real financial calculations.
     */

    savingsAccount *=
        1 + (0.04 / 365);

    recurringDeposit *=
        1 + (0.06 / 365);

    fixedDeposit *=
        1 + (0.08 / 365);
}


/* ---------------------------------------------------------
   NEXT DAY
--------------------------------------------------------- */

function nextDay() {

    if (!gameStarted) return;

    if (day >= MAX_DAYS) {

        finishGame();

        return;
    }

    dailyStartWorth =
        getNetWorth();

    /*
     * Apply today's news to the market.
     */

    moveMarkets();

    /*
     * Bank interest.
     */

    applyInterest();

    /*
     * Move to tomorrow.
     */

    day++;

    /*
     * New newspaper.
     */

    generateNews();

    /*
     * Render.
     */

    document.getElementById("marketEvent").textContent =
        "A new day begins. Read the newspaper carefully.";

    renderEverything();
}


/* ---------------------------------------------------------
   END GAME
--------------------------------------------------------- */

function finishGame() {

    moveMarkets();

    applyInterest();

    const finalWorth =
        getNetWorth();

    const profit =
        finalWorth - 100;

    document.getElementById("finalMoney").textContent =
        money(finalWorth);

    document.getElementById("finalWorth").textContent =
        money(finalWorth);

    document.getElementById("finalProfit").textContent =
        (profit >= 0 ? "+" : "") + money(profit);

    document.getElementById("finalTrades").textContent =
        totalTrades;

    let rating;

    if (finalWorth < 50) {

        rating = "💀 FINANCIAL DISASTER";

    } else if (finalWorth < 80) {

        rating = "😭 THE MARKET ATE YOU";

    } else if (finalWorth < 100) {

        rating = "📉 SURVIVED... BARELY";

    } else if (finalWorth < 125) {

        rating = "🙂 DECENT TRADER";

    } else if (finalWorth < 175) {

        rating = "🔥 MARKET SURVIVOR";

    } else if (finalWorth < 250) {

        rating = "🧠 MARKET WIZARD";

    } else {

        rating = "👑 WALL STREET DEMON";
    }

    document.getElementById("finalRating").textContent =
        rating;

    document.getElementById("endScreen")
        .classList.add("show");
}


