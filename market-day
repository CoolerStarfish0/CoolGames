</div>

</div>

</div>

<!-- TRANSACTION MODAL -->

<div class="modal" id="tradeModal">

    <div class="modal-box">

        <h2 id="modalTitle">Buy Stock</h2>

        <p id="modalDescription">
            Choose how many shares you want.
        </p>

        <input
