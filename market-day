                    <button
                        class="small-btn"
                        onclick="openTrade('sell', '${company.ticker}')">
                        SELL
                    </button>

                </div>

            </div>
        `;

        container.appendChild(stock);
    });
}


/* ---------------------------------------------------------
   TODAY'S EFFECT
--------------------------------------------------------- */

function getToday'sEffect(company) {

    if (!todayEvent) return 0;

    return todayEvent.effects[company.ticker] || 0;
}


/* ---------------------------------------------------------
   PORTFOLIO
--------------------------------------------------------- */

function renderPortfolio() {

    const container =
        document.getElementById("portfolio");

    container.innerHTML = "";

    let hasSomething = false;

    companies.forEach(company => {

        if (company.shares <= 0) return;

        hasSomething = true;

        const row =
            document.createElement("div");

        row.className = "portfolio-row";

        row.innerHTML = `

            <div>
                <strong>${company.ticker}</strong>
                <span style="color:#888">
                    × ${company.shares.toFixed(2)}
                </span>
            </div>

            <div>
                ${money(company.shares * company.price)}
            </div>

        `;

        container.appendChild(row);

    });

    const bankAccounts = [
        ["Current", currentAccount],
        ["Savings", savingsAccount],
        ["RD", recurringDeposit],
        ["FD", fixedDeposit]
    ];

    bankAccounts.forEach(([name, balance]) => {

        if (balance <= 0) return;

        hasSomething = true;

        const row =
            document.createElement("div");

        row.className = "portfolio-row";

        row.innerHTML = `
            <div>${name}</div>
            <div>${money(balance)}</div>
        `;

        container.appendChild(row);
    });

    if (!hasSomething) {

        container.innerHTML = `
            <div class="empty">
                You own nothing.<br><br>
                <strong>Congratulations.</strong><br>
                You're either a genius or terrified.
            </div>
        `;
    }
}


