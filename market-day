--------------------------------------------------------- */

function startGame() {

    gameStarted = true;

    document
        .getElementById("startScreen")
        .classList.add("hidden");

    generateNews();

    renderEverything();
}


/* ---------------------------------------------------------
   RANDOM HELPERS
--------------------------------------------------------- */

function random(min, max) {
    return Math.random() * (max - min) + min;
}

function randomInt(min, max) {
    return Math.floor(random(min, max + 1));
}

function money(value) {
    return "$" + value.toFixed(2);
}


/* ---------------------------------------------------------
   NEWS
--------------------------------------------------------- */

function generateNews() {

    todayEvent =
        newsEvents[randomInt(0, newsEvents.length - 1)];

    document.getElementById("mainHeadline").textContent =
        todayEvent.headline;

    document.getElementById("paperDate").textContent =
        `DAY ${day} • MORNING EDITION`;

    const articles = document.getElementById("articles");

    articles.innerHTML = "";

    const main = document.createElement("div");

    main.className = "article";

    main.innerHTML = `
        <div class="article-title">
            ${todayEvent.headline}
        </div>

        <div class="article-text">
            ${todayEvent.text}
        </div>

        <span class="tag">
            ${todayEvent.tag}
        </span>
    `;

    articles.appendChild(main);

    const extraEvents = shuffle(
        newsEvents.filter(e => e !== todayEvent)
    ).slice(0, 2);

    extraEvents.forEach(event => {

        const article = document.createElement("div");

        article.className = "article";

        article.innerHTML = `
            <div class="article-title">
                ${event.headline}
            </div>

            <div class="article-text">
                ${event.text}
            </div>

            <span class="tag">
                ${event.tag}
            </span>
        `;

        articles.appendChild(article);

    });
}


/* ---------------------------------------------------------
   SHUFFLE
--------------------------------------------------------- */

function shuffle(array) {

    const copy = [...array];

    for (let i = copy.length - 1; i > 0; i--) {

        const j = Math.floor(Math.random() * (i + 1));

        [copy[i], copy[j]] =
            [copy[j], copy[i]];
    }

    return copy;
}


/* ---------------------------------------------------------
   NET WORTH
--------------------------------------------------------- */

function getStockValue() {

    return companies.reduce(
        (total, company) =>
            total + company.price * company.shares,
        0
    );
}

function getTotalBankMoney() {

    return currentAccount +
        savingsAccount +
        recurringDeposit +
        fixedDeposit;
}

function getNetWorth() {

    return cash +
        getStockValue() +
        getTotalBankMoney();
}


