<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MARKET DAY</title>

<style>
* {
    box-sizing: border-box;
}

:root {
    --bg: #07070b;
    --panel: #101017;
    --panel2: #15151f;
    --border: #292938;
    --purple: #9b5cff;
    --purple2: #c084fc;
    --text: #f5f3ff;
    --muted: #9693a8;
    --green: #55e68a;
    --red: #ff647c;
    --gold: #ffd166;
}

body {
    margin: 0;
    min-height: 100vh;
    background:
        radial-gradient(circle at 15% 10%, rgba(155,92,255,.14), transparent 30%),
        radial-gradient(circle at 90% 90%, rgba(192,132,252,.08), transparent 30%),
        var(--bg);
    color: var(--text);
    font-family: Inter, Arial, sans-serif;
}

button,
input {
    font: inherit;
}

button {
    cursor: pointer;
}

.app {
    width: min(1450px, 94%);
    margin: auto;
    padding: 24px 0 50px;
}

/* HEADER */

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 22px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 13px;
}

.logo-icon {
    width: 45px;
    height: 45px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    font-size: 23px;
    background: linear-gradient(135deg, #7c3aed, #c084fc);
    box-shadow: 0 0 35px rgba(155,92,255,.3);
}

.logo h1 {
    margin: 0;
    font-size: 24px;
    letter-spacing: -1px;
}

.logo p {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 12px;
}

.day-box {
    text-align: right;
}

.day-label {
    color: var(--muted);
    font-size: 12px;
}

.day-number {
    font-size: 24px;
    font-weight: 800;
}

/* DASHBOARD */

.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 16px;
}

.stat {
    background: rgba(16,16,23,.9);
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 17px;
}

.stat-label {
    color: var(--muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .8px;
}

.stat-value {
    margin-top: 6px;
    font-size: 23px;
    font-weight: 800;
}

.green {
    color: var(--green);
}

.red {
    color: var(--red);
}

.gold {
    color: var(--gold);
}

/* LAYOUT */

.main-grid {
    display: grid;
    grid-template-columns: 1.05fr 1.5fr;
    gap: 16px;
}

.left,
.right {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.panel {
    background: rgba(16,16,23,.94);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
}

.panel-header {
    padding: 17px 19px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.panel-header h2 {
    margin: 0;
    font-size: 16px;
}

.panel-header span {
    color: var(--muted);
    font-size: 12px;
}

.panel-body {
    padding: 18px;
}

/* NEWSPAPER */

.newspaper {
    background:
        linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px);
    background-size: 100% 28px;
}

.paper-title {
    font-family: Georgia, serif;
    font-size: 34px;
    font-weight: 900;
    text-align: center;
    letter-spacing: -1.5px;
    border-bottom: 3px double #55505f;
    padding-bottom: 9px;
    margin-bottom: 14px;
}

.paper-date {
    text-align: center;
    color: var(--muted);
    font-size: 11px;
    margin-bottom: 18px;
}

.headline {
    font-family: Georgia, serif;
    font-size: 24px;
    line-height: 1.15;
    margin-bottom: 8px;
}

.article {
    border-top: 1px solid #292733;
    padding: 13px 0;
}

.article:first-of-type {
    border-top: 0;
}

.article-title {
    font-family: Georgia, serif;
    font-size: 16px;
    font-weight: bold;
}

.article-text {
    color: #aaa6b6;
    line-height: 1.5;
    font-size: 13px;
    margin-top: 5px;
}

.tag {
    display: inline-block;
    margin-top: 8px;
    padding: 4px 7px;
    border-radius: 6px;
    background: rgba(155,92,255,.12);
    color: var(--purple2);
    font-size: 10px;
    text-transform: uppercase;
}

/* STOCKS */

.stock-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.stock {
    border: 1px solid #252532;
    border-radius: 12px;
    padding: 12px;
    background: #0d0d14;
}

.stock-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.stock-name {
    font-weight: 800;
    font-size: 14px;
}

.ticker {
    color: var(--muted);
    font-size: 10px;
    margin-left: 5px;
}

.stock-sector {
    color: var(--muted);
    font-size: 10px;
    margin-top: 3px;
}

.stock-price {
    font-weight: 800;
    font-size: 15px;
}

.stock-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
}

.change {
    font-size: 12px;
    font-weight: 700;
}

.stock-actions {
    display: flex;
    gap: 5px;
}

.small-btn {
    border: 1px solid var(--border);
    background: #181822;
    color: var(--text);
    border-radius: 7px;
    padding: 5px 9px;
    font-size: 11px;
}

.small-btn:hover {
    border-color: var(--purple);
    background: #21182d;
}

/* BANK */

.bank-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 9px;
}

.account {
    border: 1px solid var(--border);
    border-radius: 11px;
    padding: 12px;
    background: #0d0d14;
}

.account-name {
    font-weight: 800;
    font-size: 13px;
}

.account-rate {
    color: var(--green);
    font-size: 10px;
    margin-top: 3px;
}

.account-balance {
    margin-top: 12px;
    font-size: 16px;
    font-weight: 800;
}

.account button {
    width: 100%;
    margin-top: 8px;
    padding: 7px;
}

/* PORTFOLIO */

.portfolio-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid #20202a;
    font-size: 13px;
}

.portfolio-row:last-child {
    border-bottom: 0;
}

.empty {
    color: var(--muted);
    text-align: center;
    padding: 25px 5px;
    font-size: 13px;
}

/* CONTROLS */

.controls {
    display: flex;
    gap: 9px;
    margin-top: 16px;
}

.primary {
    flex: 1;
    border: 0;
    padding: 14px;
    border-radius: 12px;
    color: white;
    font-weight: 800;
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    box-shadow: 0 10px 30px rgba(124,58,237,.2);
}

.primary:hover {
    filter: brightness(1.12);
}

.secondary {
    border: 1px solid var(--border);
    background: #13131b;
    color: var(--text);
    padding: 14px 18px;
    border-radius: 12px;
}

/* EVENT */

.event {
    padding: 12px;
    border-radius: 11px;
    background: rgba(155,92,255,.07);
    border: 1px solid rgba(155,92,255,.15);
    font-size: 12px;
    color: #bbb7c7;
}

/* MODAL */

.modal {
    position: fixed;
    inset: 0;
    display: none;
    place-items: center;
    padding: 20px;
    background: rgba(0,0,0,.75);
    backdrop-filter: blur(8px);
    z-index: 50;
}

.modal.open {
    display: grid;
}

.modal-box {
    width: min(500px, 100%);
    background: #111119;
    border: 1px solid #343444;
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 25px 100px rgba(0,0,0,.7);
}

.modal-box h2 {
    margin-top: 0;
}

.modal-box p {
    color: var(--muted);
    line-height: 1.5;
}

.modal-input {
    width: 100%;
    background: #09090e;
    border: 1px solid var(--border);
    color: white;
    border-radius: 10px;
    padding: 12px;
    outline: none;
}

.modal-input:focus {
    border-color: var(--purple);
}

.modal-buttons {
    display: flex;
    gap: 8px;
    margin-top: 15px;
}

.modal-buttons button {
    flex: 1;
}

/* START */

.start-screen {
    position: fixed;
    inset: 0;
    z-index: 100;
    background:
        radial-gradient(circle at 50% 40%, rgba(155,92,255,.18), transparent 35%),
        #060609;
    display: grid;
    place-items: center;
    padding: 25px;
}

.start-screen.hidden {
    display: none;
}

.start-content {
    width: min(650px, 100%);
    text-align: center;
}

.start-icon {
    font-size: 70px;
    filter: drop-shadow(0 0 30px rgba(155,92,255,.5));
}

.start-content h1 {
    margin: 10px 0 5px;
    font-size: clamp(45px, 9vw, 85px);
    letter-spacing: -5px;
}

.start-content .sub {
    color: var(--purple2);
    font-weight: 800;
    letter-spacing: 3px;
}

.start-content p {
    color: var(--muted);
    line-height: 1.7;
    max-width: 520px;
    margin: 20px auto;
}

.warning {
    border: 1px solid rgba(255,100,124,.2);
    background: rgba(255,100,124,.05);
    color: #c6aab0;
    border-radius: 12px;
    padding: 13px;
    font-size: 12px;
    margin-bottom: 18px;
}

.start-btn {
    border: 0;
    padding: 16px 45px;
    border-radius: 13px;
    color: white;
    font-weight: 900;
    font-size: 15px;
    background: linear-gradient(135deg, #7c3aed, #c084fc);
    box-shadow: 0 15px 45px rgba(124,58,237,.25);
}

/* END */

.end-screen {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: none;
    place-items: center;
    background: rgba(0,0,0,.9);
    backdrop-filter: blur(12px);
    padding: 20px;
}

.end-screen.show {
    display: grid;
}

.end-box {
    width: min(600px, 100%);
    background: #111119;
    border: 1px solid #393948;
    border-radius: 22px;
    padding: 30px;
    text-align: center;
}

.final-money {
    font-size: 52px;
    font-weight: 900;
    margin: 15px 0;
}

.rating {
    color: var(--gold);
    font-size: 25px;
    font-weight: 900;
}

.final-grid {
    display: grid;
    grid-template-columns: repeat(2,1fr);
    gap: 8px;
    margin: 22px 0;
}

.final-stat {
    background: #0b0b11;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 13px;
}

.final-stat span {
    display: block;
    color: var(--muted);
    font-size: 10px;
}

.final-stat strong {
    display: block;
    margin-top: 4px;
}

/* MOBILE */

@media(max-width: 950px) {
    .main-grid {
        grid-template-columns: 1fr;
    }
}

@media(max-width: 650px) {
    .stats {
        grid-template-columns: repeat(2,1fr);
    }

    header {
        align-items: flex-start;
    }

    .bank-grid {
        grid-template-columns: 1fr;
    }

    .paper-title {
        font-size: 27px;
    }
}
</style>
</head>

<body>

<!-- START SCREEN -->

<div class="start-screen" id="startScreen">
    <div class="start-content">
        <div class="start-icon">📈</div>

